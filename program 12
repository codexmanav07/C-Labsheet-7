#include <iostream>
#include <cstring>
using namespace std;

int main() {
    char str[] = "programming";
    char *p = strchr(str, 'g');

    if (p)
        cout << "First occurrence at position "
             << p - str + 1;
    else
        cout << "Character not found";

    return 0;
}

