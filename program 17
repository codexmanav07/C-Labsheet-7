#include <iostream>
#include <cstring>
#include <cctype>
using namespace std;

int main() {
    char str[100];
    int j = 0;

    cout << "Enter a string: ";
    cin.getline(str, 100);

    for (int i = 0; i < strlen(str); i++) {
        char c = tolower(str[i]);

        if (c != 'a' && c != 'e' && c != 'i' &&
            c != 'o' && c != 'u')
            str[j++] = str[i];
    }

    str[j] = '\0';
    cout << "Without vowels: " << str;
    return 0;
}

