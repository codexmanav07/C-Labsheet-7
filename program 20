#include <iostream>
#include <cstring>
#include <algorithm>
#include <cctype>
using namespace std;

int main() {
    char a[100], b[100];

    cout << "Enter first string: ";
    cin.getline(a, 100);
    cout << "Enter second string: ";
    cin.getline(b, 100);

    int i = 0, j = 0;

    for (int k = 0; a[k]; k++)
        if (a[k] != ' ')
            a[i++] = tolower(a[k]);
    a[i] = '\0';

    for (int k = 0; b[k]; k++)
        if (b[k] != ' ')
            b[j++] = tolower(b[k]);
    b[j] = '\0';

    sort(a, a + strlen(a));
    sort(b, b + strlen(b));

    if (strcmp(a, b) == 0)
        cout << "Strings are anagrams";
    else
        cout << "Strings are not anagrams";

    return 0;
}

