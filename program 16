#include <iostream>
#include <cstring>
using namespace std;

int main() {
    char str[200];
    int words = 0, inside = 0;

    cout << "Enter a sentence: ";
    cin.getline(str, 200);

    for (int i = 0; i < strlen(str); i++) {
        if (str[i] != ' ' && str[i] != '\t') {
            if (!inside) {
                words++;
                inside = 1;
            }
        } else {
            inside = 0;
        }
    }

    cout << "Words = " << words;
    return 0;
}

Output:
